{
  "name": "@paste-to-markdown/core",
  "version": "0.1.0",
  "description": "Core HTML-to-Markdown conversion logic for paste-to-markdown",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sbolel/paste-to-markdown.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/sbolel/paste-to-markdown/issues"
  },
  "homepage": "https://github.com/sbolel/paste-to-markdown#readme",
  "keywords": [
    "markdown",
    "html",
    "clipboard",
    "converter",
    "turndown"
  ],
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "turndown": "^7.2.2",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "devDependencies": {
    "@types/turndown": "^5.0.6",
    "marked": "^18.0.11",
    "vitest": "^4.1.2"
  }
}
