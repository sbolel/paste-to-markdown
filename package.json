{
  "name": "paste-to-markdown-workspace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sbolel/paste-to-markdown.git"
  },
  "bugs": {
    "url": "https://github.com/sbolel/paste-to-markdown/issues"
  },
  "homepage": "https://github.com/sbolel/paste-to-markdown#readme",
  "engines": {
    "node": ">=24.15.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "pnpm --filter @paste-to-markdown/web dev",
    "build": "pnpm --filter @paste-to-markdown/core build && pnpm --filter @paste-to-markdown/web build && pnpm artifact:check",
    "test": "pnpm --filter @paste-to-markdown/core test && pnpm --filter @paste-to-markdown/web test",
    "lint": "eslint .",
    "typecheck": "pnpm --filter @paste-to-markdown/core typecheck && pnpm --filter @paste-to-markdown/web typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,css,html,md,yml}\"",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "audit:prod": "pnpm audit --prod",
    "semantic-release": "semantic-release",
    "release:check": "node scripts/check-release-config.mjs",
    "artifact:check": "node scripts/check-pages-artifact.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "eslint": "^10.1.0",
    "globals": "^17.4.0",
    "prettier": "^3.8.1",
    "semantic-release": "^25.0.9",
    "typescript": "^6.0.2"
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319",
  "release": {
    "private": true,
    "branches": [
      "main"
    ],
    "tagFormat": "v${version}",
    "preset": "conventionalcommits",
    "plugins": [
      [
        "@semantic-release/commit-analyzer",
        {
          "preset": "conventionalcommits"
        }
      ],
      [
        "@semantic-release/changelog",
        {
          "changelogFile": "CHANGELOG.md"
        }
      ],
      "@semantic-release/release-notes-generator",
      [
        "@semantic-release/npm",
        {
          "npmPublish": false
        }
      ],
      [
        "@semantic-release/github",
        {
          "assets": [
            {
              "path": "dist.tar.gz",
              "label": "Distribution"
            },
            {
              "path": "CHANGELOG.md",
              "label": "Changelog"
            },
            {
              "path": "README.md",
              "label": "Readme"
            }
          ]
        }
      ]
    ],
    "repositoryUrl": "https://github.com/sbolel/paste-to-markdown.git"
  }
}
